{
  "name": "story-loom",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 2112",
    "build": "node --require ./scripts/align-next-ssr-react.cjs ./node_modules/next/dist/bin/next build",
    "start": "node --require ./scripts/align-next-ssr-react.cjs ./node_modules/next/dist/bin/next start -H 127.0.0.1 -p 2112",
    "desktop:dev": "electron .",
    "desktop:build": "node scripts/desktop-build.mjs",
    "db:setup": "tsx scripts/db-deploy.ts && prisma generate && tsx prisma/seed.ts",
    "db:info": "tsx scripts/db-info.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:inventory": "tsx scripts/db-inventory.ts",
    "db:verify-backup": "tsx scripts/db-verify-backup.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "tsx scripts/db-migrate-dev.ts",
    "db:deploy": "tsx scripts/db-deploy.ts",
    "db:seed": "tsx prisma/seed.ts",
    "schema:export": "tsx scripts/export-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mcp:stdio": "tsx scripts/mcp-stdio.ts",
    "postinstall": "prisma generate"
  },
  "build": {
    "appId": "com.storyloom.app",
    "productName": "Story Loom",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "prisma",
        "to": "standalone/prisma"
      },
      {
        "from": "node_modules/.prisma",
        "to": "standalone/node_modules/.prisma"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "diff": "^9.0.0",
    "docx": "^9.16.0",
    "dotenv": "^18.0.9",
    "jszip": "^3.10.2",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "openai": "^7.43.0",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "typo-js": "^1.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.33",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
