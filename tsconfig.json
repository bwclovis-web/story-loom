{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "node_modules/.cache/wordly-next-trial/types/**/*.ts",
    "node_modules/.cache/wordly-next-trial/dev/types/**/*.ts",
    "node_modules/.cache/wordly-build-chapter-trial/types/**/*.ts",
    "node_modules/.cache/wordly-build-chapter-trial/dev/types/**/*.ts",
    ".next-ux-verify/nav-repro/types/**/*.ts",
    ".next-ux-verify/nav-repro/dev/types/**/*.ts",
    ".next-weave-ui/types/**/*.ts",
    ".next-weave-ui/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
