DATABASE_URL="file:./prisma/dev.db"

# Optional: also copy each full backup (pnpm db:backup, pre-delete, pre-migrate)
# into this folder, e.g. a Dropbox or OneDrive path. Overrides local/backup-mirror.json.
# WORDLY_BACKUP_MIRROR_DIR=

# Optional in-app assistant (see docs/assistant.md). Leave blank to keep it off;
# the rest of the app works without it. Server-only: never prefix these with
# NEXT_PUBLIC_, and never commit a real key (.env is git-ignored).
# Story Loom uses only its own key. The general OPENAI_API_KEY, which other
# apps may share, is ignored; use a key created for this app.
WORDLY_OPENAI_API_KEY=
# A text model your OpenAI API project can use with the Responses API.
OPENAI_MODEL=

# Optional assistant limits (defaults shown).
# ASSISTANT_MAX_INPUT_CHARS=600000
# ASSISTANT_MAX_OUTPUT_TOKENS=2000
# Chapter analysis uses its own output allowance. Chat and proofreading stay at 2000.
# ASSISTANT_ANALYSIS_OUTPUT_TOKENS=8000
# ASSISTANT_MAX_REQUESTS_PER_HOUR=30
# ASSISTANT_MONTHLY_TOKEN_CAP=300000
# ASSISTANT_REQUEST_TIMEOUT_SECONDS=120

# Local read-only MCP adapter (docs/future-chatgpt-connection.md).
# Copy mcp/grant.example.json to mcp/grant.json before using it.
# Set WORDLY_MCP_DISABLED=1 to refuse every call. This does not connect ChatGPT.
# WORDLY_MCP_DISABLED=
# WORDLY_MCP_GRANT_FILE=mcp/grant.json
