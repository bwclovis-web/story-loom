// Enumerated values (record type, authority status, source kind, ...) are stored
// as strings and validated in src/domain; SQLite has no native enum type.
// JSON payloads are stored as strings and parsed in the service layer.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Workspace {
  id                     String                  @id
  name                   String
  createdAt              DateTime                @default(now())
  /// Set while the workspace is in the Trash (see src/server/services/trashService.ts).
  trashedAt              DateTime?
  projects               Project[]
  assistantConversations AssistantConversation[]
  dictionaryEntries      DictionaryEntry[]
}

model Project {
  id                     String                  @id
  workspaceId            String
  workspace              Workspace               @relation(fields: [workspaceId], references: [id])
  title                  String
  /// Optional series this book belongs to. Null = unassigned; the project opens as today.
  seriesName             String?
  /// Optional book name within the series. Null = unassigned (UI may show title).
  bookName               String?
  /// zero_draft | author_manuscript | null (unassigned).
  draftKind              String?
  /// Bumped when Series/Book/Draft assignments change; used to detect stale upgrade previews.
  assignmentRevision     Int                     @default(0)
  createdAt              DateTime                @default(now())
  /// Set while the project is in the Trash.
  trashedAt              DateTime?
  /// Explicit default draft for Read the book. Null = unset (legacy / picker).
  defaultReadingDraftId  String?
  defaultReadingDraft    ManuscriptDraft?        @relation("DefaultReadingDraft", fields: [defaultReadingDraftId], references: [id])
  /// Explicit default draft for manuscript PDF export. Null = unset.
  defaultExportDraftId   String?
  defaultExportDraft     ManuscriptDraft?        @relation("DefaultExportDraft", fields: [defaultExportDraftId], references: [id])
  records                Record[]
  manuscriptGroups       ManuscriptGroup[]
  manuscriptDrafts       ManuscriptDraft[]       @relation("ProjectDrafts")
  sources                Source[]
  changePackages         ChangePackage[]
  auditEntries           AuditEntry[]
  reviewItems            ReviewItem[]
  importedFiles          ImportedFile[]
  assistantConversations AssistantConversation[]
  assistantSettings      ProjectAssistantSettings?
  proofreadRuns          ProofreadRun[]
  dictionaryEntries      DictionaryEntry[]
  recordLinks            RecordLink[]
  recordImages           RecordImage[]
  cover                  ProjectCover?
  rewriteSourceLinks     RewriteSourceLink[]
  readingPins            ReadingPin[]
  boards                 Board[]
  boardCards             BoardCard[]
  worldMaps              WorldMap[]
  worldMapPins           WorldMapPin[]
  placeRelations         PlaceRelation[]
  weaveGrids             WeaveGrid[]
  weaveBeats             WeaveBeat[]
  weaveBeatWorldRefs     WeaveBeatWorldRef[]
  weaveThreads           WeaveThread[]
  weaveTemplates         WeaveTemplate[]
  weaveBuildRuns         WeaveBuildRun[]
  chapterAnalysisRuns    ChapterAnalysisRun[]
  establishedFacts       EstablishedFact[]
  factEvidence           FactEvidence[]
  sceneLocations         SceneLocation[]
  storyEvents            StoryEvent[]
  storyEventLocations    StoryEventLocation[]
  storyEventScenes       StoryEventScene[]
  storyEventOrders       StoryEventOrder[]
  storyEventEvidence     StoryEventEvidence[]

  @@index([workspaceId])
}

/// A Zero draft or Author manuscript tree within a project. Not revisioned content.
/// At most one draft per kind per project. Null Record.draftId means legacy unscoped manuscript.
model ManuscriptDraft {
  id        String    @id
  projectId String
  project   Project   @relation("ProjectDrafts", fields: [projectId], references: [id])
  /// zero_draft | author_manuscript
  kind      String
  label     String
  /// Set when the author explicitly marks the rewrite complete; null = not marked.
  completedAt DateTime?
  createdAt DateTime  @default(now())
  records   Record[]
  readingDefaultFor Project[] @relation("DefaultReadingDraft")
  exportDefaultFor  Project[] @relation("DefaultExportDraft")

  @@unique([projectId, kind])
  @@index([projectId])
}

/// A named group of chapters (and their scenes) within a project's manuscript.
/// Not revisioned content: creating or renaming a group does not change record text.
model ManuscriptGroup {
  id        String   @id
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  label     String
  /// Order among groups in the upgrade preview and Write tools.
  position  Int
  /// Optional draft kind for this group; null means use the project's draftKind.
  draftKind String?
  createdAt DateTime @default(now())
  records   Record[]

  @@index([projectId])
}

/// A word the author accepts as correctly spelled (see src/spelling/dictionary.ts).
/// Applies to one project, or to every project in the workspace when projectId
/// is null. It only stops spelling flags; it is not a record and has no revisions.
model DictionaryEntry {
  id            String    @id
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  word          String
  /// Lower-cased word, for duplicate checks.
  wordKey       String
  caseSensitive Boolean
  note          String    @default("")
  /// manual | editor | import | reference
  origin        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, projectId])
  @@index([workspaceId, wordKey])
}

/// Current state of a record. Every state is also captured as an immutable Revision.
model Record {
  id                    String                 @id
  projectId             String
  project               Project                @relation(fields: [projectId], references: [id])
  /// Document type (see src/domain/recordTypes.ts).
  type                  String
  title                 String
  body                  String
  /// JSON object of structured fields.
  fields                String                 @default("{}")
  /// Canon/decision status (see src/domain/statuses.ts).
  authorityStatus       String
  supersededByRecordId  String?
  /// Manuscript protection flag; independent of type and status.
  protected             Boolean                @default(false)
  /// The chapter a scene belongs to, or the chapter or scene a scene note is on
  /// (see PARENT_TYPES in src/domain/recordTypes.ts). Set when the record is
  /// created; only moving a scene to another chapter changes it. Not part of
  /// revisioned content.
  parentRecordId        String?
  /// Book order of a chapter among chapters, or a scene within its chapter
  /// (see src/domain/bookOrder.ts). Null until the author first moves something;
  /// unpositioned records follow positioned ones in creation order. Not part of
  /// revisioned content.
  position              Int?
  /// Optional manuscript group for a chapter or scene. Not revisioned content.
  groupId               String?
  group                 ManuscriptGroup?       @relation(fields: [groupId], references: [id])
  /// Optional manuscript draft (Zero draft or Author manuscript). Not revisioned content.
  draftId               String?
  draft                 ManuscriptDraft?       @relation(fields: [draftId], references: [id])
  /// For World reference records: book | series | null (unassigned = project-local as today).
  worldScope            String?
  currentRevision       Int
  /// Set while the record is in the Trash. Not part of revisioned content.
  trashedAt             DateTime?
  /// Records moved to the Trash together (a chapter with its scenes and notes)
  /// share this ID and are restored together.
  trashBatchId          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  revisions             Revision[]
  reviewItems           ReviewItem[]
  importedFiles         ImportedFile[]
  assistantContextItems AssistantContextItem[]
  proofreadRuns         ProofreadRun[]
  linksFrom             RecordLink[]           @relation("LinkFrom")
  linksTo               RecordLink[]           @relation("LinkTo")
  images                RecordImage[]
  rewriteSourcesFrom    RewriteSourceLink[]    @relation("RewriteFrom")
  rewriteSourcesTo      RewriteSourceLink[]    @relation("RewriteTo")
  readingPins           ReadingPin[]
  boardCards            BoardCard[]
  worldMapPins          WorldMapPin[]
  placeRelationsFrom    PlaceRelation[] @relation("PlaceFrom")
  placeRelationsTo      PlaceRelation[] @relation("PlaceTo")
  weaveBeatsManuscript  WeaveBeat[]           @relation("WeaveManuscript")
  weaveBeatWorldRefs    WeaveBeatWorldRef[]
  establishedFacts      EstablishedFact[]     @relation("FactSubject")
  factEvidenceSources   FactEvidence[]        @relation("FactEvidenceSource")
  sceneLocationsAsManuscript SceneLocation[]  @relation("SceneLocationManuscript")
  sceneLocationsAsPlace      SceneLocation[]  @relation("SceneLocationPlace")
  storyEventLocations        StoryEventLocation[] @relation("StoryEventPlace")
  storyEventScenes           StoryEventScene[]    @relation("StoryEventScene")
  storyEventEvidenceSources  StoryEventEvidence[] @relation("StoryEventEvidenceSource")

  @@index([projectId, type])
  @@index([parentRecordId])
  @@index([trashBatchId])
  @@index([groupId])
  @@index([draftId])
}

/// A focused World board: freeform placement of record/image cards and notes.
/// Not revisioned content. Legacy projects have none until the author creates one.
model Board {
  id          String      @id
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id])
  title       String
  /// blank | geography — creation template; the board remains fully editable.
  templateKey String      @default("blank")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cards       BoardCard[]

  @@index([projectId])
}

/// A card on a board. Positions are board-local. Source links point at a record
/// and/or image; removing a card only removes this row. The same record may
/// appear on several boards.
model BoardCard {
  id         String   @id
  boardId    String
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  /// record | image | note
  kind       String
  recordId   String?
  record     Record?  @relation(fields: [recordId], references: [id])
  imageId    String?
  image      RecordImage? @relation(fields: [imageId], references: [id])
  noteTitle  String   @default("")
  noteBody   String   @default("")
  x          Int
  y          Int
  width      Int      @default(220)
  height     Int      @default(120)
  zIndex     Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([boardId])
  @@index([projectId])
  @@index([recordId])
  @@index([imageId])
}

/// Ordered reading pins for references kept open beside prose. Scoped by project
/// and draft (`scopeDraftId` empty string = legacy project-level). Not revisioned;
/// pin/unpin never changes RecordLink. A pin alone does not authorize assistant send.
model ReadingPin {
  id            String   @id
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  /// Manuscript draft id, or "" when the project has no drafts.
  scopeDraftId  String   @default("")
  recordId      String
  record        Record   @relation(fields: [recordId], references: [id])
  position      Int
  createdAt     DateTime @default(now())

  @@unique([projectId, scopeDraftId, recordId])
  @@index([projectId, scopeDraftId])
  @@index([recordId])
}

/// Pins a rewrite chapter/scene to an exact Zero-draft revision. Not revisioned
/// content: adding or removing one is audited and never changes either record.
/// Many source scenes may feed one rewrite scene.
model RewriteSourceLink {
  id               String   @id
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  fromRecordId     String
  from             Record   @relation("RewriteFrom", fields: [fromRecordId], references: [id])
  toRecordId       String
  to               Record   @relation("RewriteTo", fields: [toRecordId], references: [id])
  toRevisionNumber Int
  /// Order among sources on the same rewrite record.
  position         Int
  createdAt        DateTime @default(now())

  @@unique([fromRecordId, toRecordId])
  @@index([projectId])
  @@index([toRecordId])
}

/// A manuscript chapter or scene linked to a reference record it draws on.
/// Links are not revisioned content: adding or removing one is audited and
/// never changes either record.
model RecordLink {
  id           String   @id
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  fromRecordId String
  from         Record   @relation("LinkFrom", fields: [fromRecordId], references: [id])
  toRecordId   String
  to           Record   @relation("LinkTo", fields: [toRecordId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([fromRecordId, toRecordId])
  @@index([projectId])
  @@index([toRecordId])
}

/// An image attached to a reference document (see src/images/imageFormat.ts).
/// Like links, images are not revisioned content: adding, editing or removing
/// one is audited and never changes the record. The text shows an image with
/// `![alt](image:name)`, resolved by `name` within the same record, so text
/// keeps working when a backup is restored with new IDs.
model RecordImage {
  id               String   @id
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  recordId         String
  record           Record   @relation(fields: [recordId], references: [id])
  name             String
  originalFilename String
  /// Detected from the file's bytes: image/png | image/jpeg | image/gif | image/webp
  mimeType         String
  byteSize         Int
  width            Int
  height           Int
  /// sha256 of `data`.
  contentHash      String
  data             Bytes
  caption          String   @default("")
  altText          String   @default("")
  /// Gallery order within the record.
  position         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  boardCards       BoardCard[]
  worldMaps        WorldMap[]

  @@unique([recordId, name])
  @@index([projectId])
}

/// One cover picture for a project. Not revisioned content: changing it does
/// not rewrite manuscript text. Absent means the home page draws a cover.
model ProjectCover {
  id               String   @id
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id])
  originalFilename String
  mimeType         String
  byteSize         Int
  width            Int
  height           Int
  /// sha256 of `data`.
  contentHash      String
  data             Bytes
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// A World map: an existing reference image used as a backdrop with markers.
/// Marker positions are normalized (0–1) relative to the image so they stay
/// aligned when the map is resized. A marker may link a reference, another
/// map, or both. Not revisioned. Soft-trashed image/record: map or marker
/// hidden or marked unavailable; permanent delete of the image removes the
/// map; permanent delete of a linked record removes markers that point at it.
model WorldMap {
  id         String        @id
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id])
  title      String
  imageId    String
  image      RecordImage   @relation(fields: [imageId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  pins       WorldMapPin[] @relation("MapPins")
  detailPins WorldMapPin[] @relation("MapDetail")

  @@index([projectId])
  @@index([imageId])
}

/// A marker on a World map. xNorm/yNorm and points are fractions of image
/// width/height (0–1). They are not distance or travel time.
/// kind is point | route | area | label. Existing rows are points.
/// points is a JSON array of {x,y}. A route keeps that order. An area is a
/// closed boundary (the last point joins the first; the closing point is not
/// stored twice). A label is text at xNorm/yNorm and stores no path.
/// A point needs a reference or another map. Route, area, and label may link
/// a reference and can also stand on their geometry or text.
/// revision increments on each saved change so a stale write is refused.
/// markerGroup is places | waterways | transport | story. Moving a marker never
/// creates or changes PlaceRelation rows.
model WorldMapPin {
  id          String    @id
  mapId       String
  map         WorldMap  @relation("MapPins", fields: [mapId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  recordId    String?
  record      Record?   @relation(fields: [recordId], references: [id])
  targetMapId String?
  targetMap   WorldMap? @relation("MapDetail", fields: [targetMapId], references: [id], onDelete: SetNull)
  markerGroup String    @default("places")
  label       String    @default("")
  /// point | route | area | label
  kind        String    @default("point")
  /// JSON [{x,y}, ...] in 0–1 image space. "[]" for a point or a label.
  points      String    @default("[]")
  revision    Int       @default(0)
  xNorm       Float
  yNorm       Float
  createdAt   DateTime  @default(now())

  @@index([mapId])
  @@index([projectId])
  @@index([recordId])
  @@index([targetMapId])
}

/// Explicit World place relationship. Not revisioned; independent of board/map
/// positions. Moving cards or pins never creates or changes these.
/// Kinds: part_of | flows_into | governed_by (from → to).
model PlaceRelation {
  id           String   @id
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  fromRecordId String
  from         Record   @relation("PlaceFrom", fields: [fromRecordId], references: [id])
  toRecordId   String
  to           Record   @relation("PlaceTo", fields: [toRecordId], references: [id])
  /// part_of | flows_into | governed_by
  kind         String
  createdAt    DateTime @default(now())

  @@unique([fromRecordId, toRecordId, kind])
  @@index([projectId])
  @@index([toRecordId])
}

/// A chapter or scene the author assigned to a World location.
/// Not a mention, not a RecordLink, not a PlaceRelation, and not an
/// EstablishedFact or planned event. No story date is stored. Order on a map
/// follows manuscript position (src/domain/bookOrder.ts).
/// At most one primary location per chapter or scene. revision increments when
/// the row changes so a stale write is refused.
model SceneLocation {
  id                 String   @id
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id])
  manuscriptRecordId String
  manuscript         Record   @relation("SceneLocationManuscript", fields: [manuscriptRecordId], references: [id])
  locationRecordId   String
  location           Record   @relation("SceneLocationPlace", fields: [locationRecordId], references: [id])
  isPrimary          Boolean  @default(false)
  revision           Int      @default(0)
  createdAt          DateTime @default(now())

  @@unique([manuscriptRecordId, locationRecordId])
  @@index([projectId])
  @@index([locationRecordId])
}

/// A story event. Not a scene location, mention, RecordLink, PlaceRelation, or
/// EstablishedFact. Chronological order is the explicit earlier/later
/// constraints, never manuscript order. An empty timeLabel means the story
/// time is unknown and is never inferred. planned stays identifiable.
model StoryEvent {
  id         String   @id
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  title      String
  summary    String   @default("")
  /// Author-written time text. Empty means unknown.
  timeLabel  String   @default("")
  planned    Boolean  @default(false)
  /// all | unscoped | a manuscript draft id
  draftScope String   @default("all")
  revision   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  locations  StoryEventLocation[]
  scenes     StoryEventScene[]
  evidence   StoryEventEvidence[]
  earlierThan StoryEventOrder[] @relation("EventEarlier")
  laterThan   StoryEventOrder[] @relation("EventLater")

  @@index([projectId])
}

/// A World location linked to a story event. Not a scene location or a map pin.
model StoryEventLocation {
  id               String     @id
  eventId          String
  event            StoryEvent @relation(fields: [eventId], references: [id])
  projectId        String
  project          Project    @relation(fields: [projectId], references: [id])
  locationRecordId String
  location         Record     @relation("StoryEventPlace", fields: [locationRecordId], references: [id])
  createdAt        DateTime   @default(now())

  @@unique([eventId, locationRecordId])
  @@index([projectId])
  @@index([locationRecordId])
}

/// A chapter or scene that reveals a story event. Several scenes may reveal one event.
model StoryEventScene {
  id                 String     @id
  eventId            String
  event              StoryEvent @relation(fields: [eventId], references: [id])
  projectId          String
  project            Project    @relation(fields: [projectId], references: [id])
  manuscriptRecordId String
  manuscript         Record     @relation("StoryEventScene", fields: [manuscriptRecordId], references: [id])
  createdAt          DateTime   @default(now())

  @@unique([eventId, manuscriptRecordId])
  @@index([projectId])
  @@index([manuscriptRecordId])
}

/// Explicit chronology: earlierEvent happens before laterEvent.
/// A cycle is rejected. This is not manuscript order.
model StoryEventOrder {
  id             String     @id
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id])
  earlierEventId String
  earlier        StoryEvent @relation("EventEarlier", fields: [earlierEventId], references: [id])
  laterEventId   String
  later          StoryEvent @relation("EventLater", fields: [laterEventId], references: [id])
  createdAt      DateTime   @default(now())

  @@unique([earlierEventId, laterEventId])
  @@index([projectId])
  @@index([laterEventId])
}

/// A source passage pinned to the revision it was taken from.
/// When that source moves past the pinned revision, needsRecheck is set.
model StoryEventEvidence {
  id             String     @id
  eventId        String
  event          StoryEvent @relation(fields: [eventId], references: [id])
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id])
  sourceRecordId String
  source         Record     @relation("StoryEventEvidenceSource", fields: [sourceRecordId], references: [id])
  revisionNumber Int
  passageStart   Int
  passageEnd     Int
  passageExcerpt String
  contentHash    String
  /// planned | zero_draft | author_rewrite
  evidenceKind   String
  needsRecheck   Boolean    @default(false)
  createdAt      DateTime   @default(now())

  @@index([eventId])
  @@index([projectId])
  @@index([sourceRecordId])
}

/// A Plan Weave grid: Original plan, Zero-draft story map, or Author rewrite plan.
/// Not revisioned. Beat positions are weave-local; moving a beat never reorders
/// manuscript chapters or scenes. Legacy projects have none until created.
model WeaveGrid {
  id               String        @id
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id])
  title            String
  /// original | zero_draft_map | author_rewrite
  viewKind         String
  /// freeform | plot_grid — presentation only; freeform x/y always retained.
  layoutMode       String        @default("freeform")
  /// Provenance only when created from a template; not a live link.
  sourceTemplateId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  beats            WeaveBeat[]
  threads          WeaveThread[]

  @@index([projectId])
  @@index([projectId, viewKind])
}

/// A story-thread column on a Weave plot-grid. Column order is thread.position;
/// never manuscript book order. Deleting a thread clears beat.threadId only.
model WeaveThread {
  id        String     @id
  gridId    String
  grid      WeaveGrid  @relation(fields: [gridId], references: [id], onDelete: Cascade)
  projectId String
  project   Project    @relation(fields: [projectId], references: [id])
  title     String
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  beats     WeaveBeat[]

  @@index([gridId])
  @@index([projectId])
  @@index([gridId, position])
}

/// A beat on a Weave grid. Optional manuscript link (chapter/scene) and World
/// references. Decision: keep | cut | move | combine | rebuild | "".
/// Freeform uses x/y; plot-grid uses threadId + manuscriptRecordId as the cell.
model WeaveBeat {
  id                   String              @id
  gridId               String
  grid                 WeaveGrid           @relation(fields: [gridId], references: [id], onDelete: Cascade)
  projectId            String
  project              Project             @relation(fields: [projectId], references: [id])
  title                String
  body                 String              @default("")
  /// keep | cut | move | combine | rebuild | ""
  decision             String              @default("")
  manuscriptRecordId   String?
  manuscriptRecord     Record?             @relation("WeaveManuscript", fields: [manuscriptRecordId], references: [id])
  /// Plot-grid column; null = not placed on a thread (still visible in freeform / Unplaced).
  threadId             String?
  thread               WeaveThread?        @relation(fields: [threadId], references: [id], onDelete: SetNull)
  /// Stack order within a plot-grid cell (same thread + manuscript row).
  cellOrder            Int                 @default(0)
  x                    Int
  y                    Int
  width                Int                 @default(220)
  height               Int                 @default(140)
  zIndex               Int                 @default(0)
  createdAt            DateTime            @default(now())
  worldRefs            WeaveBeatWorldRef[]
  setupsFrom           WeaveSetupPayoff[]  @relation("SetupFrom")
  payoffsTo            WeaveSetupPayoff[]  @relation("PayoffTo")

  @@index([gridId])
  @@index([projectId])
  @@index([manuscriptRecordId])
  @@index([threadId])
}

/// A World (or other linkable reference) record cited by a beat.
model WeaveBeatWorldRef {
  id        String    @id
  beatId    String
  beat      WeaveBeat @relation(fields: [beatId], references: [id], onDelete: Cascade)
  projectId String
  project   Project   @relation(fields: [projectId], references: [id])
  recordId  String
  record    Record    @relation(fields: [recordId], references: [id])
  createdAt DateTime  @default(now())

  @@unique([beatId, recordId])
  @@index([projectId])
  @@index([recordId])
}

/// Series setup → payoff between beats. May span projects in the same workspace
/// so a later reveal can point back to an earlier book. Independent of beat moves.
model WeaveSetupPayoff {
  id          String    @id
  workspaceId String
  fromBeatId  String
  fromBeat    WeaveBeat @relation("SetupFrom", fields: [fromBeatId], references: [id], onDelete: Cascade)
  toBeatId    String
  toBeat      WeaveBeat @relation("PayoffTo", fields: [toBeatId], references: [id], onDelete: Cascade)
  note        String    @default("")
  createdAt   DateTime  @default(now())

  @@unique([fromBeatId, toBeatId])
  @@index([workspaceId])
  @@index([toBeatId])
}

/// Editable beat template. Applying it creates an independent Weave grid copy.
model WeaveTemplate {
  id          String             @id
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id])
  title       String
  description String             @default("")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  beats       WeaveTemplateBeat[]

  @@index([projectId])
}

model WeaveTemplateBeat {
  id         String        @id
  templateId String
  template   WeaveTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String
  body       String        @default("")
  /// keep | cut | move | combine | rebuild | ""
  decision   String        @default("")
  x          Int
  y          Int
  width      Int           @default(220)
  height     Int           @default(140)
  zIndex     Int           @default(0)
  position   Int           @default(0)

  @@index([templateId])
}

/// Assistant "Build grid from draft" run. Proposal JSON is Weave-only (threads /
/// beats / planning notes). Never writes manuscript prose. Apply uses
/// weaveService with stale source checks and retry-safe suggestion keys.
model WeaveBuildRun {
  id                 String    @id
  workspaceId        String
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id])
  draftId            String?
  /// Destination grid; null until apply creates one (new-grid mode).
  gridId             String?
  gridTitle          String    @default("")
  /// original | zero_draft_map | author_rewrite
  viewKind           String
  chapterFromId      String?
  chapterToId        String?
  /// preparing | proposed | applying | applied | failed | cancelled
  status             String
  errorCode          String?
  errorMessage       String?
  /// sha256 of exact source material sent.
  sourceHash         String    @default("")
  /// sha256 of proposalJson once proposed.
  contentHash        String    @default("")
  /// JSON map recordId → revisionNumber sent with the request.
  sentRevisionsJson  String    @default("{}")
  /// Immutable proposal once status is proposed/applied.
  proposalJson       String    @default("")
  /// JSON array of suggestion keys already applied (retry-safe).
  appliedKeysJson    String    @default("[]")
  /// Author decisions JSON: { [key]: "accept"|"skip", edits, matches }.
  decisionsJson      String    @default("{}")
  model              String?
  providerResponseId String?
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  usageEstimated     Boolean   @default(false)
  requestChars       Int       @default(0)
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@index([gridId])
}

/// One Zero-draft chapter analysis. The proposal is suggestions only.
/// Apply writes events, locations, facts, evidence, and Weave beats; it never
/// rewrites the chapter. Review stays available after reload or cancellation.
model ChapterAnalysisRun {
  id                String    @id
  workspaceId       String
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id])
  chapterRecordId   String
  draftId           String
  pinnedRevision    Int
  /// preparing | proposed | applying | applied | failed | cancelled
  status            String
  errorCode         String?
  errorMessage      String?
  sourceHash        String    @default("")
  contentHash       String    @default("")
  /// Exact user message sent to the model, so a reload can show it.
  sentMaterialJson  String    @default("")
  proposalJson      String    @default("")
  appliedKeysJson   String    @default("[]")
  decisionsJson     String    @default("{}")
  /// Categories requested for this run. Empty means every category (older runs).
  categoriesJson    String    @default("[]")
  /// Author quality marks, separate from apply decisions. Not sent to the model.
  assessmentsJson   String    @default("{}")
  /// Provider code, incomplete reason, and response id. Never a credential.
  diagnosticsJson   String    @default("")
  /// Output-token cap sent with this request. 0 on older runs.
  outputTokenAllowance Int    @default(0)
  model             String?
  providerResponseId String?
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  usageEstimated    Boolean   @default(false)
  requestChars      Int       @default(0)
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@index([chapterRecordId])
}

/// A fact about a reference record ("Established in"). Not revisioned content:
/// accepting or dismissing is audited. Evidence links cite exact manuscript
/// (or plan) passages at a revision. Kinds stay distinct: planned | zero_draft |
/// author_rewrite. Extracted facts stay pending until the author accepts them.
model EstablishedFact {
  id              String         @id
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id])
  subjectRecordId String
  subject         Record         @relation("FactSubject", fields: [subjectRecordId], references: [id])
  statement       String
  /// pending | accepted | dismissed
  status          String         @default("pending")
  /// Primary stream this fact belongs to: planned | zero_draft | author_rewrite
  evidenceKind    String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  evidence        FactEvidence[]

  @@index([projectId])
  @@index([subjectRecordId])
  @@index([projectId, status])
}

/// Passage-level evidence for an EstablishedFact. Moving cards/pins never
/// creates these. When the cited source revision changes, needsRecheck is set.
model FactEvidence {
  id                   String          @id
  factId               String
  fact                 EstablishedFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  projectId            String
  project              Project         @relation(fields: [projectId], references: [id])
  sourceRecordId       String
  source               Record          @relation("FactEvidenceSource", fields: [sourceRecordId], references: [id])
  revisionNumber       Int
  passageStart         Int
  passageEnd           Int
  passageExcerpt       String
  contentHash          String
  /// planned | zero_draft | author_rewrite
  evidenceKind         String
  needsRecheck         Boolean         @default(false)
  createdAt            DateTime        @default(now())

  @@index([factId])
  @@index([projectId])
  @@index([sourceRecordId])
  @@index([sourceRecordId, needsRecheck])
}

model Revision {
  id                   String   @id
  recordId             String
  record               Record   @relation(fields: [recordId], references: [id])
  revisionNumber       Int
  title                String
  body                 String
  fields               String
  authorityStatus      String
  supersededByRecordId String?
  contentHash          String
  sourceId             String
  source               Source   @relation(fields: [sourceId], references: [id])
  createdAt            DateTime @default(now())

  @@unique([recordId, revisionNumber])
  @@index([sourceId])
}

/// Provenance: who or what produced a set of revisions.
model Source {
  id                String     @id
  projectId         String
  project           Project    @relation(fields: [projectId], references: [id])
  /// ui | change_package | markdown_import | api | restore
  kind              String
  actor             String
  conversationLabel String?
  url               String?
  packageId         String?
  /// Original filename for file imports.
  originalFilename  String?
  createdAt         DateTime   @default(now())
  revisions         Revision[]

  @@index([projectId])
}

model ChangePackage {
  /// Author/assistant-supplied package ID. Idempotency is scoped per project,
  /// so a restored copy of a project keeps its own applied-package history.
  packageId     String
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  formatVersion Int
  contentHash   String
  summary       String
  status        String
  rawJson       String
  resultJson    String
  appliedAt     DateTime @default(now())

  @@id([projectId, packageId])
}

model AuditEntry {
  id          String   @id
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  action      String
  actor       String
  sourceId    String?
  packageId   String?
  summary     String
  detailsJson String
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
}

/// A record flagged for future review. Never an edit by itself.
model ReviewItem {
  id                  String    @id
  projectId           String
  project             Project   @relation(fields: [projectId], references: [id])
  recordId            String
  record              Record    @relation(fields: [recordId], references: [id])
  packageId           String?
  triggeredByRecordId String?
  /// package_note | detected_mention
  origin              String
  note                String
  /// open | resolved
  status              String    @default("open")
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?

  @@index([projectId, status])
}

/// A file imported into a record, kept verbatim with its original filename.
model ImportedFile {
  id               String   @id
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  batchId          String
  originalFilename String
  /// sha256 of `content`; used for duplicate detection.
  contentHash      String
  content          String
  byteSize         Int
  recordId         String
  record           Record   @relation(fields: [recordId], references: [id])
  /// created | replaced
  action           String
  revisionNumber   Int
  sourceId         String
  createdAt        DateTime @default(now())

  @@index([projectId, contentHash])
  @@index([recordId])
}

/// A local discussion with the optional OpenAI assistant. It stores what was
/// asked, answered and sent. It never writes records itself; prepared change
/// proposals are applied only through the change-package pipeline.
/// Author-approved assistant preferences for a project. Absent row = defaults.
model ProjectAssistantSettings {
  id                       String   @id
  projectId                String   @unique
  project                  Project  @relation(fields: [projectId], references: [id])
  /// When true, recent complete messages fill Include up to the character budget.
  autoIncludeRecent        Boolean  @default(false)
  /// Character budget for auto-included recent messages (clamped in the service).
  recentContextBudgetChars Int      @default(8000)
  updatedAt                DateTime @updatedAt
}

model AssistantConversation {
  id          String             @id
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id])
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id])
  title       String
  /// Author-editable rolling summary; sent with the next question when non-empty.
  summary     String             @default("")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  messages    AssistantMessage[]

  @@index([workspaceId, projectId, updatedAt])
}

model AssistantMessage {
  id                 String                 @id
  conversationId     String
  conversation       AssistantConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant
  role               String
  /// chat (discussion) | proposal (asked to prepare a change proposal)
  mode               String                 @default("chat")
  content            String
  /// For assistant messages: the user message answered.
  replyToId          String?
  /// user: complete. assistant: streaming | complete | incomplete | cancelled | failed
  status             String
  errorCode          String?
  errorMessage       String?
  model              String?
  providerResponseId String?
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  /// True when the provider returned no usage and the counts are this app's estimate.
  usageEstimated     Boolean                @default(false)
  /// JSON array of earlier message IDs sent with this request.
  includedMessageIds String                 @default("[]")
  /// Characters sent (instructions + context + prior messages + question).
  requestChars       Int?
  /// JSON RetrievalMeta: tool audit, omissions, unsaved-prose flag (discussion turns).
  retrievalJson      String?
  createdAt          DateTime               @default(now())
  completedAt        DateTime?
  contextItems       AssistantContextItem[]
  proposal           AssistantProposal?

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

/// A change package prepared by the assistant and assembled by the server.
/// `packageJson` is immutable and marked "proposed"; applying it goes through
/// applyChangePackage with server-set approval.
model AssistantProposal {
  id             String           @id
  messageId      String           @unique
  message        AssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workspaceId    String
  projectId      String
  packageId      String
  packageJson    String
  /// Content hash of packageJson; the Apply action must name it.
  contentHash    String
  operationCount Int
  /// proposed | applied
  status         String           @default("proposed")
  createdAt      DateTime         @default(now())
  appliedAt      DateTime?

  @@index([projectId, status])
}

/// One AI proofreading request on a record revision (whole text or a range).
/// Counts toward the assistant's usage limits. Suggestions are returned to the
/// editor and not stored; accepting one edits the text box only, and saving
/// goes through the normal record save.
model ProofreadRun {
  id                  String    @id
  workspaceId         String
  projectId           String
  project             Project   @relation(fields: [projectId], references: [id])
  recordId            String
  record              Record    @relation(fields: [recordId], references: [id])
  revisionNumber      Int
  /// proofread (the only mode implemented)
  mode                String    @default("proofread")
  /// document | selection
  scope               String
  /// Range sent, in the record text with line endings as "\n".
  rangeStart          Int
  rangeEnd            Int
  /// sha256 of the exact text sent.
  contentHash         String
  /// running | complete | incomplete | cancelled | failed
  status              String
  errorCode           String?
  errorMessage        String?
  model               String?
  providerResponseId  String?
  inputTokens         Int?
  outputTokens        Int?
  totalTokens         Int?
  usageEstimated      Boolean   @default(false)
  requestChars        Int
  /// Dictionary words sent with the request as accepted spellings.
  dictionaryTermCount Int       @default(0)
  suggestionCount     Int       @default(0)
  rejectedCount       Int       @default(0)
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  @@index([projectId, recordId, createdAt])
  @@index([createdAt])
}

/// A record revision (or a passage of it) sent with an assistant request.
model AssistantContextItem {
  id             String           @id
  messageId      String
  message        AssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recordId       String
  record         Record           @relation(fields: [recordId], references: [id])
  revisionNumber Int
  /// reference | manuscript | passage | section (passageStart/End hold the section's offsets)
  kind           String
  passageStart   Int?
  passageEnd     Int?
  charCount      Int
  /// sha256 of the exact text sent for this item.
  contentHash    String

  @@index([messageId])
  @@index([recordId])
}
