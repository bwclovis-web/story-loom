// Enumerated values (record type, authority status, source kind, ...) are stored
// as strings and validated in src/domain; SQLite has no native enum type.
// JSON payloads are stored as strings and parsed in the service layer.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Workspace {
  id                     String                  @id
  name                   String
  createdAt              DateTime                @default(now())
  /// Set while the workspace is in the Trash (see src/server/services/trashService.ts).
  trashedAt              DateTime?
  projects               Project[]
  assistantConversations AssistantConversation[]
  dictionaryEntries      DictionaryEntry[]
}

model Project {
  id                     String                  @id
  workspaceId            String
  workspace              Workspace               @relation(fields: [workspaceId], references: [id])
  title                  String
  /// Optional series this book belongs to. Null = unassigned; the project opens as today.
  seriesName             String?
  /// Optional book name within the series. Null = unassigned (UI may show title).
  bookName               String?
  /// zero_draft | author_manuscript | null (unassigned).
  draftKind              String?
  /// Bumped when Series/Book/Draft assignments change; used to detect stale upgrade previews.
  assignmentRevision     Int                     @default(0)
  createdAt              DateTime                @default(now())
  /// Set while the project is in the Trash.
  trashedAt              DateTime?
  /// Explicit default draft for Read the book. Null = unset (legacy / picker).
  defaultReadingDraftId  String?
  defaultReadingDraft    ManuscriptDraft?        @relation("DefaultReadingDraft", fields: [defaultReadingDraftId], references: [id])
  /// Explicit default draft for manuscript PDF export. Null = unset.
  defaultExportDraftId   String?
  defaultExportDraft     ManuscriptDraft?        @relation("DefaultExportDraft", fields: [defaultExportDraftId], references: [id])
  records                Record[]
  manuscriptGroups       ManuscriptGroup[]
  manuscriptDrafts       ManuscriptDraft[]       @relation("ProjectDrafts")
  sources                Source[]
  changePackages         ChangePackage[]
  auditEntries           AuditEntry[]
  reviewItems            ReviewItem[]
  importedFiles          ImportedFile[]
  assistantConversations AssistantConversation[]
  proofreadRuns          ProofreadRun[]
  dictionaryEntries      DictionaryEntry[]
  recordLinks            RecordLink[]
  recordImages           RecordImage[]
  rewriteSourceLinks     RewriteSourceLink[]

  @@index([workspaceId])
}

/// A Zero draft or Author manuscript tree within a project. Not revisioned content.
/// At most one draft per kind per project. Null Record.draftId means legacy unscoped manuscript.
model ManuscriptDraft {
  id        String    @id
  projectId String
  project   Project   @relation("ProjectDrafts", fields: [projectId], references: [id])
  /// zero_draft | author_manuscript
  kind      String
  label     String
  /// Set when the author explicitly marks the rewrite complete; null = not marked.
  completedAt DateTime?
  createdAt DateTime  @default(now())
  records   Record[]
  readingDefaultFor Project[] @relation("DefaultReadingDraft")
  exportDefaultFor  Project[] @relation("DefaultExportDraft")

  @@unique([projectId, kind])
  @@index([projectId])
}

/// A named group of chapters (and their scenes) within a project's manuscript.
/// Not revisioned content: creating or renaming a group does not change record text.
model ManuscriptGroup {
  id        String   @id
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  label     String
  /// Order among groups in the upgrade preview and Write tools.
  position  Int
  /// Optional draft kind for this group; null means use the project's draftKind.
  draftKind String?
  createdAt DateTime @default(now())
  records   Record[]

  @@index([projectId])
}

/// A word the author accepts as correctly spelled (see src/spelling/dictionary.ts).
/// Applies to one project, or to every project in the workspace when projectId
/// is null. It only stops spelling flags; it is not a record and has no revisions.
model DictionaryEntry {
  id            String    @id
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  word          String
  /// Lower-cased word, for duplicate checks.
  wordKey       String
  caseSensitive Boolean
  note          String    @default("")
  /// manual | editor | import | reference
  origin        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, projectId])
  @@index([workspaceId, wordKey])
}

/// Current state of a record. Every state is also captured as an immutable Revision.
model Record {
  id                    String                 @id
  projectId             String
  project               Project                @relation(fields: [projectId], references: [id])
  /// Document type (see src/domain/recordTypes.ts).
  type                  String
  title                 String
  body                  String
  /// JSON object of structured fields.
  fields                String                 @default("{}")
  /// Canon/decision status (see src/domain/statuses.ts).
  authorityStatus       String
  supersededByRecordId  String?
  /// Manuscript protection flag; independent of type and status.
  protected             Boolean                @default(false)
  /// The chapter a scene belongs to, or the chapter or scene a scene note is on
  /// (see PARENT_TYPES in src/domain/recordTypes.ts). Set when the record is
  /// created; only moving a scene to another chapter changes it. Not part of
  /// revisioned content.
  parentRecordId        String?
  /// Book order of a chapter among chapters, or a scene within its chapter
  /// (see src/domain/bookOrder.ts). Null until the author first moves something;
  /// unpositioned records follow positioned ones in creation order. Not part of
  /// revisioned content.
  position              Int?
  /// Optional manuscript group for a chapter or scene. Not revisioned content.
  groupId               String?
  group                 ManuscriptGroup?       @relation(fields: [groupId], references: [id])
  /// Optional manuscript draft (Zero draft or Author manuscript). Not revisioned content.
  draftId               String?
  draft                 ManuscriptDraft?       @relation(fields: [draftId], references: [id])
  /// For World reference records: book | series | null (unassigned = project-local as today).
  worldScope            String?
  currentRevision       Int
  /// Set while the record is in the Trash. Not part of revisioned content.
  trashedAt             DateTime?
  /// Records moved to the Trash together (a chapter with its scenes and notes)
  /// share this ID and are restored together.
  trashBatchId          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  revisions             Revision[]
  reviewItems           ReviewItem[]
  importedFiles         ImportedFile[]
  assistantContextItems AssistantContextItem[]
  proofreadRuns         ProofreadRun[]
  linksFrom             RecordLink[]           @relation("LinkFrom")
  linksTo               RecordLink[]           @relation("LinkTo")
  images                RecordImage[]
  rewriteSourcesFrom    RewriteSourceLink[]    @relation("RewriteFrom")
  rewriteSourcesTo      RewriteSourceLink[]    @relation("RewriteTo")

  @@index([projectId, type])
  @@index([parentRecordId])
  @@index([trashBatchId])
  @@index([groupId])
  @@index([draftId])
}

/// Pins a rewrite chapter/scene to an exact Zero-draft revision. Not revisioned
/// content: adding or removing one is audited and never changes either record.
/// Many source scenes may feed one rewrite scene.
model RewriteSourceLink {
  id               String   @id
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  fromRecordId     String
  from             Record   @relation("RewriteFrom", fields: [fromRecordId], references: [id])
  toRecordId       String
  to               Record   @relation("RewriteTo", fields: [toRecordId], references: [id])
  toRevisionNumber Int
  /// Order among sources on the same rewrite record.
  position         Int
  createdAt        DateTime @default(now())

  @@unique([fromRecordId, toRecordId])
  @@index([projectId])
  @@index([toRecordId])
}

/// A manuscript chapter or scene linked to a reference record it draws on.
/// Links are not revisioned content: adding or removing one is audited and
/// never changes either record.
model RecordLink {
  id           String   @id
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  fromRecordId String
  from         Record   @relation("LinkFrom", fields: [fromRecordId], references: [id])
  toRecordId   String
  to           Record   @relation("LinkTo", fields: [toRecordId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([fromRecordId, toRecordId])
  @@index([projectId])
  @@index([toRecordId])
}

/// An image attached to a reference document (see src/images/imageFormat.ts).
/// Like links, images are not revisioned content: adding, editing or removing
/// one is audited and never changes the record. The text shows an image with
/// `![alt](image:name)`, resolved by `name` within the same record, so text
/// keeps working when a backup is restored with new IDs.
model RecordImage {
  id               String   @id
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  recordId         String
  record           Record   @relation(fields: [recordId], references: [id])
  name             String
  originalFilename String
  /// Detected from the file's bytes: image/png | image/jpeg | image/gif | image/webp
  mimeType         String
  byteSize         Int
  width            Int
  height           Int
  /// sha256 of `data`.
  contentHash      String
  data             Bytes
  caption          String   @default("")
  altText          String   @default("")
  /// Gallery order within the record.
  position         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([recordId, name])
  @@index([projectId])
}

model Revision {
  id                   String   @id
  recordId             String
  record               Record   @relation(fields: [recordId], references: [id])
  revisionNumber       Int
  title                String
  body                 String
  fields               String
  authorityStatus      String
  supersededByRecordId String?
  contentHash          String
  sourceId             String
  source               Source   @relation(fields: [sourceId], references: [id])
  createdAt            DateTime @default(now())

  @@unique([recordId, revisionNumber])
  @@index([sourceId])
}

/// Provenance: who or what produced a set of revisions.
model Source {
  id                String     @id
  projectId         String
  project           Project    @relation(fields: [projectId], references: [id])
  /// ui | change_package | markdown_import | api
  kind              String
  actor             String
  conversationLabel String?
  url               String?
  packageId         String?
  /// Original filename for file imports.
  originalFilename  String?
  createdAt         DateTime   @default(now())
  revisions         Revision[]

  @@index([projectId])
}

model ChangePackage {
  /// Author/assistant-supplied package ID. Idempotency is scoped per project,
  /// so a restored copy of a project keeps its own applied-package history.
  packageId     String
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  formatVersion Int
  contentHash   String
  summary       String
  status        String
  rawJson       String
  resultJson    String
  appliedAt     DateTime @default(now())

  @@id([projectId, packageId])
}

model AuditEntry {
  id          String   @id
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  action      String
  actor       String
  sourceId    String?
  packageId   String?
  summary     String
  detailsJson String
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
}

/// A record flagged for future review. Never an edit by itself.
model ReviewItem {
  id                  String    @id
  projectId           String
  project             Project   @relation(fields: [projectId], references: [id])
  recordId            String
  record              Record    @relation(fields: [recordId], references: [id])
  packageId           String?
  triggeredByRecordId String?
  /// package_note | detected_mention
  origin              String
  note                String
  /// open | resolved
  status              String    @default("open")
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?

  @@index([projectId, status])
}

/// A file imported into a record, kept verbatim with its original filename.
model ImportedFile {
  id               String   @id
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  batchId          String
  originalFilename String
  /// sha256 of `content`; used for duplicate detection.
  contentHash      String
  content          String
  byteSize         Int
  recordId         String
  record           Record   @relation(fields: [recordId], references: [id])
  /// created | replaced
  action           String
  revisionNumber   Int
  sourceId         String
  createdAt        DateTime @default(now())

  @@index([projectId, contentHash])
  @@index([recordId])
}

/// A local discussion with the optional OpenAI assistant. It stores what was
/// asked, answered and sent. It never writes records itself; prepared change
/// proposals are applied only through the change-package pipeline.
model AssistantConversation {
  id          String             @id
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id])
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id])
  title       String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  messages    AssistantMessage[]

  @@index([workspaceId, projectId, updatedAt])
}

model AssistantMessage {
  id                 String                 @id
  conversationId     String
  conversation       AssistantConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant
  role               String
  /// chat (discussion) | proposal (asked to prepare a change proposal)
  mode               String                 @default("chat")
  content            String
  /// For assistant messages: the user message answered.
  replyToId          String?
  /// user: complete. assistant: streaming | complete | incomplete | cancelled | failed
  status             String
  errorCode          String?
  errorMessage       String?
  model              String?
  providerResponseId String?
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  /// True when the provider returned no usage and the counts are this app's estimate.
  usageEstimated     Boolean                @default(false)
  /// JSON array of earlier message IDs sent with this request.
  includedMessageIds String                 @default("[]")
  /// Characters sent (instructions + context + prior messages + question).
  requestChars       Int?
  createdAt          DateTime               @default(now())
  completedAt        DateTime?
  contextItems       AssistantContextItem[]
  proposal           AssistantProposal?

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

/// A change package prepared by the assistant and assembled by the server.
/// `packageJson` is immutable and marked "proposed"; applying it goes through
/// applyChangePackage with server-set approval.
model AssistantProposal {
  id             String           @id
  messageId      String           @unique
  message        AssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workspaceId    String
  projectId      String
  packageId      String
  packageJson    String
  /// Content hash of packageJson; the Apply action must name it.
  contentHash    String
  operationCount Int
  /// proposed | applied
  status         String           @default("proposed")
  createdAt      DateTime         @default(now())
  appliedAt      DateTime?

  @@index([projectId, status])
}

/// One AI proofreading request on a record revision (whole text or a range).
/// Counts toward the assistant's usage limits. Suggestions are returned to the
/// editor and not stored; accepting one edits the text box only, and saving
/// goes through the normal record save.
model ProofreadRun {
  id                  String    @id
  workspaceId         String
  projectId           String
  project             Project   @relation(fields: [projectId], references: [id])
  recordId            String
  record              Record    @relation(fields: [recordId], references: [id])
  revisionNumber      Int
  /// proofread (the only mode implemented)
  mode                String    @default("proofread")
  /// document | selection
  scope               String
  /// Range sent, in the record text with line endings as "\n".
  rangeStart          Int
  rangeEnd            Int
  /// sha256 of the exact text sent.
  contentHash         String
  /// running | complete | incomplete | cancelled | failed
  status              String
  errorCode           String?
  errorMessage        String?
  model               String?
  providerResponseId  String?
  inputTokens         Int?
  outputTokens        Int?
  totalTokens         Int?
  usageEstimated      Boolean   @default(false)
  requestChars        Int
  /// Dictionary words sent with the request as accepted spellings.
  dictionaryTermCount Int       @default(0)
  suggestionCount     Int       @default(0)
  rejectedCount       Int       @default(0)
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  @@index([projectId, recordId, createdAt])
  @@index([createdAt])
}

/// A record revision (or a passage of it) sent with an assistant request.
model AssistantContextItem {
  id             String           @id
  messageId      String
  message        AssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recordId       String
  record         Record           @relation(fields: [recordId], references: [id])
  revisionNumber Int
  /// reference | manuscript | passage | section (passageStart/End hold the section's offsets)
  kind           String
  passageStart   Int?
  passageEnd     Int?
  charCount      Int
  /// sha256 of the exact text sent for this item.
  contentHash    String

  @@index([messageId])
  @@index([recordId])
}
